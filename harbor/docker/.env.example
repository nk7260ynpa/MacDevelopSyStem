# Harbor Docker Compose 環境變數範本。
#
# 使用方式：
#   cp .env.example .env
#   並依需求調整以下變數後，於 docker-compose.yaml 內以 ${VAR_NAME} 引用。
# 注意：.env 已於專案 .gitignore 內排除，不會提交至版本控制。
#
# 目前 docker-compose.yaml 為求明確而未引用本檔任何變數，以下僅為預留範本；
# 改動這裡「不會」改變實際部署。版本升級請直接改 docker-compose.yaml 的 8 個
# image、Dockerfile 的 FROM 與 build.sh 的 PREPARE_IMAGE。

# Harbor 版本（image tag）。正式版至 v2.15.3-rc1 只提供 amd64，本機為 arm64，
# 故改用含 arm64 原生映像的 dev 標籤（v2.16.0 開發版）。實際部署另以 index
# digest 釘死同一批建置，各映像 digest 不同，故此處僅記錄 tag，完整寫法見
# docker-compose.yaml 與 build.sh 的 goharbor/<image>:dev@sha256:<digest>。
HARBOR_VERSION=dev

# 對外 HTTP port（預設 8081，避開 GitLab 之 8080）
HARBOR_HTTP_PORT=8081

# admin 初始密碼（官方預設 Harbor12345，首次登入後請立即修改）
HARBOR_ADMIN_PASSWORD=Harbor12345

# PostgreSQL 密碼
HARBOR_DB_PASSWORD=root123
