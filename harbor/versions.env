# Harbor 映像版本的唯一真相。
#
# K8s 與 Docker Compose 兩套方案共用本檔：manifests 以 __HARBOR_IMAGE_XXX__
# 佔位符撰寫、由 k8s/apply.sh 渲染，docker-compose.yaml 則以 ${HARBOR_IMAGE_XXX}
# 取用。換版只改這裡一處，不必再逐檔同步 digest。
#
# 為何是 dev 標籤加 digest：Harbor 正式版至 v2.15.3-rc1 仍只提供 amd64，本機為
# arm64，故改用唯一含 arm64 原生映像的 dev 標籤（v2.16.0 開發版）。dev 是每日
# 建置的浮動標籤，而 manifests 皆為 imagePullPolicy: IfNotPresent，單靠標籤會讓
# 各 service 混到不同天的建置，故逐映像釘上 index digest。
#
# 換版時到 Docker Hub 取「同一天」的 9 個 index digest 一起換掉，混到不同批建置
# 會讓各 service 跑在互不相容的版本上。目前釘的是 2026-09-16 那批。
#
# 格式限制：本檔同時被 bash source 與 Docker Compose 讀取，故只允許 KEY=VALUE、
# # 註解與空行，值一律是不加引號的 repo:tag@sha256:… 完整字串。
HARBOR_IMAGE_PREPARE=goharbor/prepare:dev@sha256:453da3cb34e155d58426f7ce508abd78e5fb574b60885c848a6a403c9bb65e3d
HARBOR_IMAGE_REGISTRY=goharbor/registry-photon:dev@sha256:d61f728a88f94f7aa273bc28115030bac17619f452bfe3da66bb48c7e291e827
HARBOR_IMAGE_REGISTRYCTL=goharbor/harbor-registryctl:dev@sha256:bc1c0cd1b4805ed8283ceb3d61345c23c7313d235fa87feef882cfde4e8ba0a7
HARBOR_IMAGE_DB=goharbor/harbor-db:dev@sha256:caf122ae29d195e66f5f36ca2e6ca2629d897540000b0324a6bebcc3158afc7e
HARBOR_IMAGE_REDIS=goharbor/valkey-photon:dev@sha256:c615eac36282e6005b4b829dfac964f3fa957f49011e0db6d15accbe5b3755bc
HARBOR_IMAGE_CORE=goharbor/harbor-core:dev@sha256:fef1f0825017f6fec9c9420dc0766ed3b7a201843f20e1967be28ca99fdb70a3
HARBOR_IMAGE_PORTAL=goharbor/harbor-portal:dev@sha256:b0747b89ca2c392dc443d0bb4f95a7e94ce4cb5066003fe559ed0becfb596804
HARBOR_IMAGE_JOBSERVICE=goharbor/harbor-jobservice:dev@sha256:efde3d5cf76ae551954ae312e940e56ff552fccf8ad06bd215280bc1da4d473f
HARBOR_IMAGE_PROXY=goharbor/nginx-photon:dev@sha256:8468bf54523cd6189c2b87c5650105b443e098474c0fb76f4abbcfb4ad395825
